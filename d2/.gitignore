# D2 arm scratch that is either regenerable or pure noise.  The EVIDENCE is log.txt (wall/load/md5/T-line count +
# md5), err.txt (the engine's own lines: decode timing, submit census, resident numbers), out.txt (the PP/T/DONE
# lines = the greedy token ids) and timeline.txt (phase stamps).  Run data lives under d2/runs/ because the card
# asks for the raw output here; the big ones are excluded so a commit stays reviewable.
runs/*/ask.txt
runs/*/stdin.fifo
runs/*/drive.pid
runs/*/hist.txt
runs/*/sites.csv

# D2b (t_2b6b6797): the per-arm ladder / window-state dumps (~1-2 MB each) - regenerable, see the arm command
# in runs/<tag>/log.txt; the derived tables are committed under d2/plain/ instead.
*.bin.lb*
window-state.bin
ladder.bin.lb*
d2/plain/*.bin
